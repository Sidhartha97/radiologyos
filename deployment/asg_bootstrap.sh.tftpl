#!/bin/bash
set -euo pipefail
dnf install -y docker
systemctl enable --now docker amazon-ssm-agent
mkdir -p /opt/radiologyos
cat > /usr/local/bin/radiologyos-run <<'RUN'
#!/bin/bash
set -euo pipefail
umask 077
REGION='${region}'
PARAMETER='${image_parameter}'
CONFIG_SECRET='${config_secret_arn}'
IMAGE=""
for attempt in $(seq 1 180); do
  IMAGE=$(aws ssm get-parameter --region "$REGION" --name "$PARAMETER" --query 'Parameter.Value' --output text 2>/dev/null || true)
  if [[ "$IMAGE" == *'.dkr.ecr.'*'.amazonaws.com/'*:* && "$IMAGE" != "bootstrap" ]]; then break; fi
  sleep 10
done
if [[ -z "$IMAGE" || "$IMAGE" == "bootstrap" ]]; then echo 'No deployed image is configured in Parameter Store.' >&2; exit 1; fi
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$${IMAGE%%/*}"
docker pull "$IMAGE"
aws secretsmanager get-secret-value --region "$REGION" --secret-id "$CONFIG_SECRET" --query SecretString --output text | python3 -c '
import json,sys
data=json.load(sys.stdin)
with open("/opt/radiologyos/runtime.env","w",encoding="utf-8") as target:
 for key,value in data.items():
  if not key.replace("_", "").isalnum() or "\n" in str(value) or "\r" in str(value): raise SystemExit("Invalid application environment")
  target.write(key+"="+str(value)+"\n")
'
exec docker run --rm --name radiologyos --network host --env-file /opt/radiologyos/runtime.env --log-opt max-size=10m --log-opt max-file=2 --mount source=radiologyos-uploads,target=/app/uploads "$IMAGE"
RUN
chmod 700 /usr/local/bin/radiologyos-run
cat > /etc/systemd/system/radiologyos.service <<'SERVICE'
[Unit]
Description=RadiologyOS application container behind ALB
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
[Service]
Type=simple
ExecStart=/usr/local/bin/radiologyos-run
ExecStop=/usr/bin/docker stop -t 30 radiologyos
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable --now radiologyos.service

